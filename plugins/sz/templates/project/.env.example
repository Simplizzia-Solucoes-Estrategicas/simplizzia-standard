# Copy to .env.local (never committed) and fill in. Only src/lib/env.ts reads these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS: used by src/lib/supabase/admin.ts in webhook and cron code.
SUPABASE_SECRET_KEY=
# Optional: shared secret sent by the scheduler as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
